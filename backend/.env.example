# Copy this file to .env and fill in real values. Never commit the real .env file.

# Security
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./data/retailiq.db

# LLM Provider (required only for /api/v1/agents endpoints - CrewAI multi-agent generation)
# Groq is preferred when set (fast, generous free tier). Falls back to OpenAI if
# GROQ_API_KEY is empty. If neither is set, agents return simulated template output.
GROQ_API_KEY=
OPENAI_API_KEY=

# App
ENVIRONMENT=development
DEBUG=true
CONFIG_PATH=config/config.yaml
